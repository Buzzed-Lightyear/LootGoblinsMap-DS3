{
  // Game install root (the folder containing Game/DarkSoulsIII.exe, or the Game folder itself).
  // From WSL the same folder is "/mnt/g/SteamLibrary/steamapps/common/DARK SOULS III".
  "gamePath": "G:\\SteamLibrary\\steamapps\\common\\DARK SOULS III",
  // External mod override folder, or null — this install has mods inside the game folder.
  "modPath": null,
  // The map shown before the game says which one you are in.
  "mapId": "m30_00_00_00",
  // Which maps to build: "all" (every map found in the archives) or a comma-separated list of ids.
  "maps": "all",
  // Folder of the game text under /msg, for item, bonfire and area names.
  "language": "engus",
  "outDir": "out",
  "workDir": "work",
  "pixelsPerMeter": 6.0,
  // Orientation of the map image. The tracker's "Save orientation" button rewrites these three.
  "flipX": false,
  "flipZ": false,
  "rotation": 0,
  // Layers. "floors": a connected floor stays on one layer and the layer changes on stairs.
  // "stack": the phase 1 behaviour (each polygon on the lowest layer with room for it).
  "layerMode": "floors",
  // Surfaces stacked further apart than this (metres) can never share a layer.
  "layerSplitHeight": 1.8,
  // "floors" only: largest step (metres) across which two level areas still count as one floor.
  "layerJoinStep": 0.6,
  // "floors" only: polygons no steeper than this (degrees) are level floor, steeper ones stairs/ramps.
  "layerFlatSlopeDegrees": 15
}
